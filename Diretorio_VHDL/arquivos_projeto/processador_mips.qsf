set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY processador_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name VHDL_SHOW_LMF_MAPPING_MESSAGES OFF

# ------------------------------------------------------------------
# Hardware (datapath + controle)
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Testbench modular (somente para simulacao)
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Simulacao (ModelSim-Altera)
# ------------------------------------------------------------------
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (VHDL)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH tb_processador_top -section_id eda_simulation

# ------------------------------------------------------------------
# NOTA: memfile.dat (usado por imem.vhd) e input.txt (usado por stimulus.vhd)
# sao lidos por caminho relativo ao diretorio de execucao da simulacao.
# Copie-os de ../arquivos_auxiliares/ para a pasta de trabalho do ModelSim,
# ou ajuste o caminho no init_mem()/open do respectivo arquivo VHDL.
# ------------------------------------------------------------------

set_global_assignment -name LAST_QUARTUS_VERSION 13.1
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name EDA_TEST_BENCH_NAME tb_processador_top -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_processador_top
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_processador_top -section_id tb_processador_top
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name EDA_TEST_BENCH_FILE ../simulacao_testbench/tb_processador_top.vhd -section_id tb_processador_top
set_global_assignment -name VHDL_FILE ../hardware/pcnext.vhd
set_global_assignment -name VHDL_FILE ../hardware/pc.vhd
set_global_assignment -name VHDL_FILE ../hardware/imem.vhd
set_global_assignment -name VHDL_FILE ../hardware/dmem.vhd
set_global_assignment -name VHDL_FILE ../hardware/regfile.vhd
set_global_assignment -name VHDL_FILE ../hardware/ula.vhd
set_global_assignment -name VHDL_FILE ../hardware/alu_control.vhd
set_global_assignment -name VHDL_FILE ../hardware/control_unit.vhd
set_global_assignment -name VHDL_FILE ../hardware/signext.vhd
set_global_assignment -name VHDL_FILE ../hardware/sl2.vhd
set_global_assignment -name VHDL_FILE ../hardware/processador_top.vhd
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top