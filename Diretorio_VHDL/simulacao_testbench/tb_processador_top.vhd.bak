library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

-- Testbench do processador completo (sem external names / sem VHDL-2008).
-- Roda o programa carregado em memfile.dat. Nao contem asserts: serve para
-- capturar as formas de onda (waveforms) no ModelSim para o relatorio.
-- No ModelSim, apos rodar, adicione os sinais internos com:
--     add wave -r /tb_processador_top/DUT/*
entity tb_processador_top is
end tb_processador_top;

architecture sim of tb_processador_top is
    signal clk   : STD_LOGIC := '0';
    signal reset : STD_LOGIC := '1';
    constant TCLK : time := 20 ns;
begin

    DUT : entity work.processador_top
        port map ( clk => clk, reset => reset );

    -- clock
    clk <= not clk after TCLK/2;

    -- reset inicial e tempo de execucao
    stim : process
    begin
        reset <= '1';
        wait for 2*TCLK;
        reset <= '0';
        wait for 40*TCLK;   -- tempo suficiente p/ o programa
        wait;
    end process;

end sim;
